# ---------------------------------------------------------------------------
# Household Finance Sync
#
# Everything in the first three sections is private financial data or
# credentials. A .gitignore only stops FUTURE commits — if any of these have
# already been committed, see "Publishing checklist" in README.md first.
# ---------------------------------------------------------------------------

# --- Credentials -----------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Local data written by the program -------------------------------------
# state.json  : linked Plaid items, cursors, account balances, access tokens
# ledger.json : every transaction ever pulled
state.json
ledger.json
*.json.tmp
backups/

# --- Your configuration ----------------------------------------------------
# config.json grows to hold Plaid account ids, real names, custom account
# labels, savings-goal amounts, and merchant patterns naming your employer,
# landlord and utilities. The committed template is config.example.json.
config.json
!config.example.json

# --- Workbooks (real data, demo output, Excel lock/recovery files) ----------
*.xlsx
*.xlsm
*.xls
*.xlsb
*.csv
~$*
.~lock.*#

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
