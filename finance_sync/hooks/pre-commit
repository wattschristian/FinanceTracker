#!/usr/bin/env bash
# Blocks a commit that would publish private financial data.
# Install:  git config core.hooksPath hooks     (from the repo root)
set -u

blocked=$(git diff --cached --name-only --diff-filter=ACM | grep -E \
  '(^|/)(\.env$|\.env\.[^/]*$|config\.json$|state\.json$|ledger\.json$)|\.(xlsx|xlsm|xls|xlsb|csv)$|(^|/)backups/' \
  | grep -v -E '(^|/)(\.env\.example|config\.example\.json)$' || true)

if [ -n "$blocked" ]; then
  echo "pre-commit: refusing to commit private files:"
  echo "$blocked" | sed 's/^/  /'
  echo
  echo "These hold bank data or credentials. Unstage them:"
  echo "  git restore --staged <file>"
  echo "If one is genuinely safe and you mean it:  git commit --no-verify"
  exit 1
fi

# Secret-shaped strings in the staged diff (Plaid ids/secrets are 24-32 hex chars).
if git diff --cached -U0 | grep -nE '^\+.*(PLAID_(CLIENT_ID|SECRET)[[:space:]]*=[[:space:]]*[A-Za-z0-9]{8,}|access-(production|sandbox)-[A-Za-z0-9-]+)' >/dev/null; then
  echo "pre-commit: a staged line looks like a live Plaid credential or access token."
  echo "Remove it, then commit again (or --no-verify if it is a placeholder)."
  exit 1
fi
exit 0
